{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Maestro application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "pty:default",
    "pty:allow-spawn",
    "pty:allow-write",
    "pty:allow-resize",
    "pty:allow-kill",
    "shell:allow-execute",
    "updater:default",
    "process:default",
    "process:allow-restart",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "deep-link:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
