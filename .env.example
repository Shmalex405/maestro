# Docker
DOCKER_SOCKET=/var/run/docker.sock

# Database
DB_PATH=./data/pentest.db

# Scope
SCOPE_CONFIG_PATH=./config/scope.yml

# Jira Integration
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=automation@yourcompany.com
JIRA_API_TOKEN=your-api-token

# SharePoint Integration
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/Security
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_FOLDER_PATH=/SecurityReports

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=security@yourcompany.com
SMTP_PASS=your-app-password
SMTP_FROM=security@yourcompany.com

# ===================
# Application Credentials
# ===================

# Main Web Application
WEBAPP_USERNAME=test@yourcompany.com
WEBAPP_PASSWORD=your-test-password

# Internal API
API_BEARER_TOKEN=your-bearer-token

# Partner API
PARTNER_API_KEY=your-api-key

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password

# OAuth2
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Test Accounts (for authorization testing)
TEST_ADMIN_USER=admin@test.com
TEST_ADMIN_PASS=admin-pass
TEST_USER_USER=user@test.com
TEST_USER_PASS=user-pass
TEST_READONLY_USER=readonly@test.com
TEST_READONLY_PASS=readonly-pass

# Credentials Config
CREDENTIALS_CONFIG_PATH=./config/credentials.yml


# ===========================================
# AUTONOMOUS RUNNER (Required for N8N automation)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
AUTONOMOUS_PORT=3001