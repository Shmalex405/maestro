{
  "name": "maestro-e2e-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop end-to-end tests for Maestro, driven by tauri-driver via WebdriverIO. Linux-only — runs in CI; macOS devs use the in-process Vitest suite + manual checklist.",
