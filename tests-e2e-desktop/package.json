    "@wdio/cli": "^9.2.0",
    "@wdio/local-runner": "^9.2.0",
    "@wdio/mocha-framework": "^9.2.0",
    "@wdio/spec-reporter": "^9.2.0",
    "@wdio/types": "^9.2.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "webdriverio": "^9.2.0"
  }
}
